# 数据库（PostgreSQL 连接串）
DATABASE_URL=postgresql://wall:wall@127.0.0.1:5433/confession_wall

# DeepSeek 内容审核
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 登录态密钥（改成随机长字符串）
AUTH_SECRET=

# 注册该邮箱的用户自动成为管理员
ADMIN_EMAIL=

# 邮箱验证码（126邮箱免费 SMTP）
SMTP_HOST=smtp.126.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的126邮箱@126.com
SMTP_PASS=你的126授权码
SMTP_FROM=你的126邮箱@126.com

# 人机验证（Cloudflare Turnstile，可选，国内建议换腾讯云防水墙/极验）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
